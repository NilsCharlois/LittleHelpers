@page "/testCalendar"
@using Heron.MudCalendar
@using LittleHelpers.Service
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject IMealPlannerService MealPlannerService

<MudDialogProvider />
<MudPopoverProvider />

<MudCalendar T="CalendarItem"
    Items="_events"
    MonthCellMinHeight="0"
    CellClicked="CellClicked"
    ItemClicked="ItemClicked"
    CellRangeSelected="CellRangeSelected"
    CellContextMenuClicked="OpenMenuContent"
    DayTimeInterval="CalendarTimeInterval.Minutes180"
>
    <MonthTemplate>
        <div class="d-flex gap-1">
            <MudIcon Icon="@Icons.Material.Filled.SetMeal" Color="Color.Secondary" Size="Size.Small" />
            <div>@context.Text</div>
        </div>
    </MonthTemplate>
</MudCalendar>

<MudMenu PositionAtCursor="true" @ref="_contextMenu">
    <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="AddEvent">
        Add an event
    </MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="RemoveAllEvents">
        Delete all events in this cell
    </MudMenuItem>
</MudMenu>

@code{
    private List<CalendarItem> _events = [];

    protected override Task OnInitializedAsync()
    {
        List<MealsForDay> mealsForDays = MealPlannerService.GetAllPlannedDays();
        _events = mealsForDays.Select(p => new CalendarItem(){
            AllDay = true,
            Start = DateTime.ParseExact(p.Date, "yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture),
            End = DateTime.ParseExact(p.Date, "yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture),
            Text = "Test"
        }).ToList();
        return base.OnInitializedAsync();
    }

    private async void CellClicked(DateTime dateTime)
    {
        string date = dateTime.ToString("yyyy/MM/dd");
        MealsForDay mealsForDay = MealPlannerService.GetMealsPlannedForDay(date);
        var parameters = new MudBlazor.DialogParameters
            {
            ["Model"] = mealsForDay
            };

        var dialog = await DialogService.ShowAsync<MealsPickerFormDialog>("Pick meals", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var model = (MealsForDay)result.Data;

            MealPlannerService.Update(model);
        }

    }

    private Task ItemClicked(CalendarItem item)
    {
        return DialogService.ShowMessageBoxAsync("Item Clicked", item.Text);
    }

    private DateTime? _contextMenuDate;
    private MudMenu _contextMenu = null!;

    private async Task OpenMenuContent(CalendarClickEventArgs args)
    {
        _contextMenuDate = args.DateTime;
        await _contextMenu.OpenMenuAsync(args.MouseEventArgs);
    }

    private Task AddEvent()
    {
        return DialogService.ShowMessageBoxAsync("Adding an event", _contextMenuDate.Value.ToString(Thread.CurrentThread.CurrentCulture));
    }

    private Task RemoveAllEvents()
    {
        return DialogService.ShowMessageBoxAsync("Removing all events", _contextMenuDate.Value.ToString(Thread.CurrentThread.CurrentCulture));
    }


    private Task CellRangeSelected(MudBlazor.DateRange dateRange)
    {
        TimeSpan timeSpan = dateRange.End.Value.Subtract(dateRange.Start.Value);
        if(timeSpan >  new TimeSpan(24, 0, 0))
        {
            return DialogService.ShowMessageBoxAsync("Cell Range Selected", $"Start: {dateRange.Start?.ToString(Thread.CurrentThread.CurrentCulture)} End: {dateRange.End?.ToString(Thread.CurrentThread.CurrentCulture)}");
        }
        return Task.CompletedTask;
    }
}
